<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="S8_P4.MainPage">

    <StackLayout Padding="25"
                 Spacing="20"
                 VerticalOptions="Center">

        <Label Text="Suma de Dos Números"
               FontSize="24"
               HorizontalOptions="Center" />

        <Entry x:Name="txtNumero1"
               Placeholder="Número 1"
               Keyboard="Numeric" />

        <Entry x:Name="txtNumero2"
               Placeholder="Número 2"
               Keyboard="Numeric" />

        <Button Text="Sumar"
                Clicked="Sumar_Clicked" />

        <Button Text="Restar"
                Clicked="Restar_Clicked" />

        <Button Text="Multiplicar"
                Clicked="Multiplicar_Clicked" />

        <Button Text="Dividir"
                Clicked="Dividir_Clicked" />

        <Label x:Name="lblResultado"
               FontSize="20"
               HorizontalOptions="Center" />

    </StackLayout>

</ContentPage>
